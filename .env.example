# ─── Tadka environment ────────────────────────────────────────────────────────
# Copy to .env (never commit .env). Variables prefixed VITE_ are bundled into the
# browser and are PUBLIC — never put secrets in them.

# Runtime
NODE_ENV=development            # development | test | production
PORT=4000
WEB_ORIGIN=http://localhost:5173 # exact origin of the web app (CORS, cookies, socket origin check, redirects)
APP_BASE_URL=http://localhost:4000 # public URL of this API (Twilio status callbacks)
LOG_LEVEL=info

# Database — must be a replica set (transactions). `npm run dev:db` provides one locally.
MONGODB_URI=mongodb://127.0.0.1:27017/tadka?replicaSet=rs0

# Auth — required in production; at least 32 random characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Payments: mock (dev only, refused in production) | stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=              # sk_test_… (server only)
STRIPE_WEBHOOK_SECRET=          # whsec_… from `stripe listen` or the dashboard endpoint
MOCK_PAYMENT_SECRET=dev-only-mock-payment-secret

# SMS: mock (records messages, sends nothing) | twilio
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=             # or use a Messaging Service instead:
TWILIO_MESSAGING_SERVICE_SID=

# Google Maps — server key (Geocoding + Routes APIs), restrict by IP
GOOGLE_MAPS_SERVER_KEY=

# Delivery tracking demo mode (labelled simulated route). Always forced off in production.
ALLOW_DEMO_LOCATION=true

# Background jobs (notification dispatch, partner dispatch, timeouts)
JOBS_ENABLED=true
JOB_INTERVAL_MS=5000

# ─── Web (public, bundled into the browser) ──────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=       # browser key: restrict to your HTTP referrers + Maps JavaScript API only
VITE_GOOGLE_MAPS_MAP_ID=
