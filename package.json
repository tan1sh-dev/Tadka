{
  "name": "tadka-food-delivery",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w @tadka/api\" \"npm run dev -w @tadka/web\"",
    "dev:db": "npm run db -w @tadka/api",
    "seed": "npm run seed -w @tadka/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @tadka/api && npm run build -w @tadka/web",
    "e2e": "npm run e2e -w @tadka/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "engines": { "node": ">=20" }
}
